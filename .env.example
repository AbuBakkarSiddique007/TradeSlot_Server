PORT=5000
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
JWT_SECRET="your_jwt_secret"
FLAT_BOOKING_FEE_GBP=15.00
FLAT_JOB_PRICE_GBP=100.00
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PUBLIC_BASE_URL=https://tradeslot-server.onrender.com
CLIENT_BASE_URL=https://trade-slot-theta.vercel.app

# Trading timezone offset for the "business day" key (WorkArea zones + slot day).
# Default 360 = Asia/Dhaka (UTC+6). Both dev (Bangladesh) and UTC-hosted
# (Render) closer compute the same day key.
BUSINESS_UTC_OFFSET_MINUTES=360

# IANA timezone pinned as the process timezone so server-printed times and slot
# hours are the trading region's wall clock on every host (dev + Render/UTC).
# Keep in sync with BUSINESS_UTC_OFFSET_MINUTES.
BUSINESS_TZ=Asia/Dhaka

# WhatsApp Cloud API (Meta test mode). WHATSAPP_MODE=mock falls back to the
# log-only mock adapter; "meta" uses the real Graph API (implemented in later
# phases). WHATSAPP_WEBHOOK_VERIFY_TOKEN enables the GET verify handshake.
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_random_verify_token"
WHATSAPP_APP_SECRET=""
