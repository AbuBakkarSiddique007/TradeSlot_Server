generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  WHATSAPP
  WEB_CHATBOT
}

enum BookingStatus {
  PENDING
  OFFERED
  CONFIRMED
  PAYMENT_PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ConversationState {
  INITIAL
  AWAITING_SERVICE_DETAILS
  AWAITING_SLOT_SELECTION
  OFFERED_SLOT
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
}

model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  traders   Trader[]
}

model Trader {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email              String   @unique
  passwordHash       String
  name               String
  phone              String?
  stripeAccountId    String?  @unique
  stripeOnboarded    Boolean  @default(false)
  workingHoursStart  String   @default("08:00")
  workingHoursEnd    String   @default("18:00")
  defaultJobDuration Int      @default(60)
  defaultBufferTime  Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workAreas WorkArea[]
  bookings  Booking[]

  @@index([businessId])
}

model WorkArea {
  id          String   @id @default(uuid())
  traderId    String
  trader      Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  zoneName    String
  postalCodes String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([traderId, date])
  @@index([traderId, date])
}

model Customer {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChatSession[]
  bookings Booking[]
}

model ChatSession {
  id              String            @id @default(uuid())
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  senderRef       String
  channelType     ChannelType
  state           ConversationState @default(INITIAL)
  metadata        Json?
  lastInteraction DateTime          @default(now())
  createdAt       DateTime          @default(now())

  messages InboundMessage[]

  @@unique([channelType, senderRef])
  @@index([senderRef])
}

model InboundMessage {
  id          String       @id @default(uuid())
  sessionId   String?
  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  channelType ChannelType
  senderRef   String
  content     String
  rawPayload  Json?
  timestamp   DateTime     @default(now())

  @@index([channelType, senderRef])
}

model Booking {
  id                 String      @id @default(uuid())
  traderId           String
  trader             Trader      @relation(fields: [traderId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channelType        ChannelType
  customerRef        String
  customerName       String?
  customerLocation   String
  serviceDescription String

  startTime       DateTime
  endTime         DateTime
  bufferMinutes   Int      @default(30)
  bufferedEndTime DateTime

  status     BookingStatus @default(PENDING)
  totalPrice Decimal       @db.Decimal(10, 2)
  feeAmount  Decimal       @db.Decimal(10, 2)
  currency   String        @default("gbp")

  payment   Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traderId, startTime, endTime])
  @@index([status])
}

model Payment {
  id                      String        @id @default(uuid())
  bookingId               String        @unique
  booking                 Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  amount                  Decimal       @db.Decimal(10, 2)
  applicationFeeAmount    Decimal       @db.Decimal(10, 2)
  traderPayoutAmount      Decimal       @db.Decimal(10, 2)
  currency                String        @default("gbp")
  status                  PaymentStatus @default(UNPAID)
  stripeReceiptUrl        String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([stripePaymentIntentId])
  @@index([status])
}
